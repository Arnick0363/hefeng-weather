.page {
  min-height: 100vh;
  background: #e7eef6;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.head {
  background: linear-gradient(180deg, #16324f, #2a628f);
  color: #ffffff;
  padding: 28rpx 32rpx 32rpx;
}

.city {
  display: block;
  font-size: 40rpx;
  font-weight: 650;
}

.sub,
.note {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.body {
  padding: 20rpx 24rpx;
}

.group {
  margin-bottom: 22rpx;
}

.group-title {
  display: block;
  font-size: 30rpx;
  font-weight: 650;
  margin: 8rpx 8rpx 12rpx;
}

.row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.row.sunrise,
.row.sunset {
  background: #fff6e8;
  justify-content: center;
}

.time {
  width: 92rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.emoji {
  width: 64rpx;
  font-size: 40rpx;
  text-align: center;
}

.mid {
  flex: 1;
  min-width: 0;
}

.cond {
  display: block;
  font-size: 28rpx;
}

.subline {
  display: block;
  margin-top: 4rpx;
  color: #5c6b7a;
  font-size: 22rpx;
  line-height: 1.4;
}

.temp {
  font-size: 36rpx;
  font-weight: 650;
  margin-left: 12rpx;
}

.sun-line {
  color: #8a5a00;
  font-size: 28rpx;
  font-weight: 650;
}

.state {
  color: #3d4b5c;
  font-size: 28rpx;
  padding: 12rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
}

.state-title {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
  color: #1a2332;
}

.state-desc,
.sun {
  display: block;
  margin-top: 12rpx;
  line-height: 1.55;
}

.sun {
  color: #8a5a00;
}

.btn,
.text-btn {
  margin-top: 18rpx;
  text-align: center;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
}

.btn {
  background: #1d4f91;
  color: #ffffff;
}

.text-btn {
  display: inline-block;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}
