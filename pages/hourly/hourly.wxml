<view class="page">
  <view class="head">
    <text class="city">{{cityName}}</text>
    <text class="sub">{{focusLabel || '按日期分组的逐小时预报'}}</text>
    <text class="note" wx:if="{{hourNote}}">{{hourNote}}</text>
    <view wx:if="{{focusDate}}" class="text-btn" bindtap="showAll">查看全部逐小时</view>
  </view>

  <view class="body">
    <view wx:if="{{loading}}" class="state">正在获取逐小时预报…</view>
    <view wx:elif="{{error}}" class="state card">
      <text class="state-title">逐小时预报暂时无法显示</text>
      <text class="state-desc">{{error}}</text>
      <view class="btn" bindtap="load">重试</view>
    </view>
    <view wx:elif="{{emptyDay}}" class="state card">
      <text class="state-title">暂无逐小时数据</text>
      <text class="state-desc">{{focusLabel}}超出当前逐小时预报的覆盖范围。</text>
      <text class="sun" wx:if="{{focusSun}}">{{focusSun}}</text>
    </view>
    <block wx:else>
      <view class="group" wx:for="{{groups}}" wx:for-item="group" wx:key="date">
        <text class="group-title">{{group.title}}</text>
        <view wx:for="{{group.items}}" wx:for-item="row" wx:key="key" class="row {{row.kind}}">
          <block wx:if="{{row.kind === 'hour'}}">
            <text class="time">{{row.time}}</text>
            <text class="emoji">{{row.emoji}}</text>
            <view class="mid">
              <text class="cond">{{row.text}}</text>
              <text class="subline">{{row.sub}}</text>
            </view>
            <text class="temp">{{row.temp}}°</text>
          </block>
          <text wx:else class="sun-line">{{row.label}}</text>
        </view>
      </view>
      <view wx:if="{{!groups.length && !loading}}" class="state">暂无逐小时数据</view>
    </block>
  </view>
</view>
