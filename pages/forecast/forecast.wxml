<view class="page">
  <view class="head">
    <text class="city">{{cityName}}</text>
    <text class="sub">同一页切换 7 日、15 日和 30 日</text>
    <view class="seg">
      <view class="seg-item {{span === '7d' ? 'on' : ''}}" data-span="7d" bindtap="onSpan">7 日</view>
      <view class="seg-item {{span === '15d' ? 'on' : ''}}" data-span="15d" bindtap="onSpan">15 日</view>
      <view class="seg-item {{span === '30d' ? 'on' : ''}}" data-span="30d" bindtap="onSpan">30 日</view>
    </view>
  </view>

  <view class="body">
    <view wx:if="{{loading}}" class="state">正在获取预报…</view>
    <view wx:elif="{{listError}}" class="state card">
      <text class="state-title">这段预报暂时无法显示</text>
      <text class="state-desc">{{listError}}</text>
    </view>
    <block wx:else>
      <view
        wx:for="{{days}}"
        wx:key="date"
        class="day {{item.isToday ? 'today' : ''}}"
        data-date="{{item.date}}"
        data-sunrise="{{item.sunrise}}"
        data-sunset="{{item.sunset}}"
        bindtap="openDay"
      >
        <view class="day-top">
          <view>
            <view class="when">
              <text class="week">{{item.week}}</text>
              <text wx:if="{{item.isToday}}" class="badge">今天</text>
            </view>
            <text class="date">{{item.dateText}}</text>
          </view>
          <view class="temps">
            <text class="hi">{{item.tempMax}}°</text>
            <text class="lo">{{item.tempMin}}°</text>
          </view>
        </view>
        <view class="sky">
          <view class="sky-item">
            <text class="em">{{item.dayEmoji}}</text>
            <text>白天 {{item.textDay}}</text>
          </view>
          <view class="sky-item">
            <text class="em">{{item.nightEmoji}}</text>
            <text>夜间 {{item.textNight}}</text>
          </view>
        </view>
        <text class="meta">{{item.windText}}</text>
        <text class="meta">{{item.precipText}} · 湿度 {{item.humidity}}% · 紫外线 {{item.uv}}</text>
        <text class="sun">日出 {{item.sunrise}} · 日落 {{item.sunset}}</text>
        <text class="moon" wx:if="{{item.moon}}">{{item.moon}}</text>
      </view>
    </block>
  </view>
  <tab-bar current="forecast" />
</view>
