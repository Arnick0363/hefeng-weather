.page {
  min-height: 100vh;
  background: #e7eef6;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.head {
  background: linear-gradient(180deg, #16324f, #2f6fed);
  color: #ffffff;
  padding: 28rpx 32rpx 36rpx;
}

.city {
  display: block;
  font-size: 40rpx;
  font-weight: 650;
}

.sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.seg {
  display: flex;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.88);
}

.seg-item.on {
  background: #ffffff;
  color: #16324f;
  font-weight: 650;
}

.body {
  padding: 20rpx 24rpx 12rpx;
}

.day {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 48, 84, 0.05);
}

.day.today {
  background: #f3f8ff;
  border: 2rpx solid #2f6fed;
}

.day-top,
.sky,
.when {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.when {
  justify-content: flex-start;
}

.week {
  font-size: 34rpx;
  font-weight: 650;
}

.badge {
  margin-left: 12rpx;
  background: #2f6fed;
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.date,
.meta,
.sun,
.moon {
  display: block;
  color: #5c6b7a;
  font-size: 24rpx;
  margin-top: 6rpx;
  line-height: 1.45;
}

.temps {
  text-align: right;
}

.hi,
.lo {
  display: block;
}

.hi {
  font-size: 40rpx;
  font-weight: 650;
  color: #1a2332;
}

.lo {
  color: #7b8794;
  font-size: 28rpx;
}

.sky {
  margin-top: 16rpx;
  justify-content: flex-start;
}

.sky-item {
  display: flex;
  align-items: center;
  width: 50%;
  font-size: 28rpx;
  color: #1a2332;
}

.em {
  font-size: 40rpx;
  margin-right: 8rpx;
}

.sun {
  color: #8a5a00;
  margin-top: 10rpx;
}

.state {
  padding: 28rpx 8rpx;
  color: #3d4b5c;
  font-size: 28rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
}

.state-title {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
  color: #1a2332;
}

.state-desc {
  display: block;
  margin-top: 12rpx;
  line-height: 1.55;
}
